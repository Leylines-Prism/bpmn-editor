        <dc:Bounds x="2136" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_checks" bpmnElement="checks" bioc:stroke="#9A6200" bioc:fill="#FDF3E1" color:background-color="#FDF3E1" color:border-color="#9A6200">
        <dc:Bounds x="2336" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ok" bpmnElement="ok" isMarkerVisible="true">
        <dc:Bounds x="2536" y="1055" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2520" y="1022" width="83" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_rollback" bpmnElement="rollback" bioc:stroke="#9A6200" bioc:fill="#FDF3E1" color:background-color="#FDF3E1" color:border-color="#9A6200">
