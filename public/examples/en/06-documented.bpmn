<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmnpilot="https://bpmn.leylines.fr/schema/bpmn-pilot/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Néréide Networks · SD-WAN onboarding" processRef="Process_onboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Process_onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_client" name="Customer">
        <bpmn:flowNodeRef>inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pm" name="Project manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kickoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_eng" name="Network engineering">
        <bpmn:flowNodeRef>audit_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>configs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>portal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_noc" name="NOC">
        <bpmn:flowNodeRef>install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Contract signed">
      <bpmn:outgoing>Flow_start_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="kickoff" name="Hold the kick-off" bpmnpilot:assignee="Claire Morel" bpmnpilot:systems="ITSM, project management tool" bpmnpilot:accountable="Head of operations" bpmnpilot:consulted="Customer" bpmnpilot:informed="NOC, network engineering">
      <bpmn:documentation>## Purpose
Align the scope, the wave plan and the governance with the customer.

## Deliverables
- Plan: site survey (W1 to W3), HLD (W4 to W6), 2-site pilot (W9), 5 waves of 7 to 8 sites (W10 to W16), 30-day hypercare
- Escalation matrix and on-site contacts
- Site inventory template sent to the customer
- Accepted maintenance window (MW) slots: Tuesday to Thursday, 10 pm to 2 am

## Watch out
DIA fibre lead time: 6 to 8 weeks. Order the circuits at kick-off.</bpmn:documentation>
      <bpmn:incoming>Flow_start_1</bpmn:incoming>
      <bpmn:outgoing>Flow_kickoff_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="inventory" name="Provide the site inventory" bpmnpilot:systems="Spreadsheet, customer portal" bpmnpilot:accountable="Customer CIO" bpmnpilot:informed="Project manager">
      <bpmn:documentation>For each branch: site code, address, on-site contact, access hours.

| Data | Example |
|---|---|
| Current underlay | 20 Mb/s MPLS, carrier-managed CE router |
| New links | 300 Mb/s DIA fibre, 4G/5G backup |
| LAN | 3 VLANs: data, voice, guest |
| Prefixes | 10.40.12.0/24, 10.140.12.0/25 |
| Critical applications | ERP (SaaS), VoIP, point of sale |</bpmn:documentation>
      <bpmn:incoming>Flow_kickoff_1</bpmn:incoming>
      <bpmn:outgoing>Flow_inventory_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="audit_merge">
      <bpmn:incoming>Flow_inventory_1</bpmn:incoming>
      <bpmn:incoming>Flow_fix_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="audit" name="Run the site survey" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="CMDB, IPAM, survey app" bpmnpilot:accountable="Engineering lead" bpmnpilot:consulted="Customer" bpmnpilot:informed="Project manager">
      <bpmn:documentation>## Site survey checklist
- [ ] Access links delivered, tested for throughput (iPerf) and latency to the hubs
- [ ] 4G/5G coverage measured at the antenna location (RSRP &gt; -100 dBm)
- [ ] Rack space (1U), two UPS-backed power outlets
- [ ] Addressing plan with no overlap with other sites (IPAM)
- [ ] LAN ports and VLANs recorded on the access switch
- [ ] Photos of the rack and of the carrier demarc

Target: half a day per site. A finding blocks the site, not the wave.</bpmn:documentation>
      <bpmn:incoming>Flow_audit_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ready" name="Sites ready?">
      <bpmn:incoming>Flow_audit_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ready_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ready_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="fix" name="Clear the survey findings" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Network engineering" bpmnpilot:informed="Project manager">
      <bpmn:documentation>Typical findings: DIA circuit not delivered, power outlet not on UPS, address overlap with another site, 4G antenna to relocate.</bpmn:documentation>
      <bpmn:incoming>Flow_ready_2</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="design" name="Write the HLD and LLD" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="SD-WAN orchestrator, IPAM, wiki" bpmnpilot:accountable="Engineering lead" bpmnpilot:consulted="Security" bpmnpilot:informed="Customer">
      <bpmn:documentation>## HLD (High-Level Design)
- Hub and spoke topology: 2 data center hubs (active/active), 40 spokes
- Underlay: MPLS kept during the migration, DIA fibre, 4G/5G backup
- Overlay: IPsec tunnels from each spoke to both hubs, over every transport
- Routing: BGP in the overlay, eBGP to the PE on the MPLS link, BFD on every tunnel
- Application-aware policies: voice on MPLS (DIA fallback), SaaS through local breakout on DIA, guest on DIA only
- QoS: 4 classes (voice EF, interactive AF41, business AF21, best effort)
- Segmentation: 3 VRFs (corporate, voice, guest)

## LLD (Low-Level Design)
One sheet per site: interfaces, VLANs, prefixes, ASN, BGP neighbors, SLA probe thresholds, CPE serial number.</bpmn:documentation>
      <bpmn:incoming>Flow_ready_1</bpmn:incoming>
      <bpmn:outgoing>Flow_design_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approve" name="Sign off the HLD" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Customer CISO" bpmnpilot:informed="Project manager">
      <bpmn:documentation>The HLD is signed off before any CPE order. Any later change goes through a scope change request.</bpmn:documentation>
      <bpmn:incoming>Flow_design_1</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="configs" name="Build the ZTP templates" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="SD-WAN orchestrator, Git repository, IPAM" bpmnpilot:accountable="Engineering lead" bpmnpilot:informed="NOC">
      <bpmn:documentation>One template per site profile (small, medium, dual link), with variables taken from the LLD and the IPAM, the source of truth versioned in Git.

The CPE reaches the site with no configuration. Once plugged in, it calls the orchestrator, authenticates with its certificate and serial number, and gets its configuration (zero-touch provisioning).</bpmn:documentation>
      <bpmn:incoming>Flow_approve_1</bpmn:incoming>
      <bpmn:outgoing>Flow_configs_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="install" name="Ship and rack the CPEs" bpmnpilot:assignee="On-site technician (subcontractor)" bpmnpilot:systems="ITSM, logistics tool" bpmnpilot:accountable="NOC lead" bpmnpilot:informed="Customer">
      <bpmn:documentation>The technician racks the CPE, connects the DIA circuit and the 4G antenna, without touching the LAN. The CPE comes up through ZTP and shows "online" in the orchestrator before the MW.</bpmn:documentation>
      <bpmn:incoming>Flow_configs_1</bpmn:incoming>
      <bpmn:outgoing>Flow_install_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="cutover_merge">
      <bpmn:incoming>Flow_install_1</bpmn:incoming>
      <bpmn:incoming>Flow_rollback_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="cutover" name="Cut over the wave of sites" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, ITSM" bpmnpilot:accountable="NOC lead" bpmnpilot:consulted="Customer" bpmnpilot:informed="Project manager">
      <bpmn:documentation>## Pre-checks (T-30 min)
- RFC approved, number posted on the bridge channel
- CPE online in the orchestrator, valid certificate, right software release
- Backup of the MPLS CE router configuration
- On-site contact reachable, test call to the VoIP system

## During the MW (10 pm to 2 am)
1. Move the LAN from the CE router to the SD-WAN CPE
2. Check that tunnels and BGP sessions come up
3. Advertise the site prefixes into the overlay
4. Keep the CE router in place for 7 days, cable ready for a fallback

Target: 45 min per site, 7 to 8 sites per wave. Go/no-go point at T+60 min.</bpmn:documentation>
      <bpmn:incoming>Flow_cutover_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="checks" name="Run the post-checks" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, monitoring" bpmnpilot:accountable="NOC lead" bpmnpilot:informed="Customer">
      <bpmn:documentation>## Post-checks
1. IPsec tunnels up to both hubs, over DIA, MPLS and 4G
2. BGP sessions Established, received prefix count matching the LLD
3. BFD up, SLA probes within thresholds: latency &lt; 50 ms, jitter &lt; 10 ms, loss &lt; 1 % for the voice class
4. Application-aware routing: voice goes over MPLS, SaaS through local breakout
5. DSCP marking preserved end to end
6. Failover test: unplug the DIA, the ongoing call holds, convergence &lt; 1 s, then cut MPLS, 4G takes over
7. SNMP, syslog and NetFlow reaching the NOC monitoring

## Rollback criteria
- Critical application unreachable for more than 15 min
- Tunnels still down 30 min after the cutover
- Packet loss &gt; 2 % on the voice class</bpmn:documentation>
      <bpmn:incoming>Flow_cutover_1</bpmn:incoming>
      <bpmn:outgoing>Flow_checks_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ok" name="Post-checks passed?">
      <bpmn:incoming>Flow_checks_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ok_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ok_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rollback" name="Execute the rollback" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, ITSM" bpmnpilot:accountable="NOC lead" bpmnpilot:informed="Customer, project manager">
      <bpmn:documentation>1. Move the LAN back to the MPLS CE router, restore its configuration
2. Withdraw the site prefixes from the overlay
3. Check VoIP and the ERP from the site
4. Close the RFC as "rolled back", open a problem record, reschedule the site in the next wave

Target: 20 min, within the MW.</bpmn:documentation>
      <bpmn:incoming>Flow_ok_2</bpmn:incoming>
      <bpmn:outgoing>Flow_rollback_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="acceptance" name="Sign the acceptance" bpmnpilot:systems="Customer portal" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Project manager">
      <bpmn:documentation>The customer runs the acceptance plan per wave (business applications, VoIP, guest access, link failover) and signs the acceptance report. A minor finding does not prevent sign-off.</bpmn:documentation>
      <bpmn:incoming>Flow_ok_1</bpmn:incoming>
      <bpmn:outgoing>Flow_acceptance_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="portal" name="Open the customer portal (SSO)" bpmnpilot:systems="Customer portal, customer&#39;s directory (SAML)" bpmnpilot:accountable="Engineering lead" bpmnpilot:informed="Customer">
      <bpmn:documentation>SAML federation with the customer directory, two roles (read-only, network admin). The portal shows site availability, quality per link and SLA compliance.</bpmn:documentation>
      <bpmn:incoming>Flow_acceptance_1</bpmn:incoming>
      <bpmn:outgoing>Flow_portal_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="training" name="Train the customer&#39;s teams" bpmnpilot:assignee="Claire Morel" bpmnpilot:accountable="Head of operations" bpmnpilot:informed="Customer">
      <bpmn:documentation>Two 2-hour sessions: reading the portal and the SLA reports, raising an incident and the escalation path.</bpmn:documentation>
      <bpmn:incoming>Flow_portal_1</bpmn:incoming>
      <bpmn:outgoing>Flow_training_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="run" name="Hand over to Run" bpmnpilot:assignee="NOC lead" bpmnpilot:systems="ITSM, monitoring, CMDB" bpmnpilot:accountable="Head of operations" bpmnpilot:informed="Customer, project manager">
      <bpmn:documentation>## Handover pack
- Up-to-date architecture document and LLD (as-built)
- CMDB populated: CPEs, circuits, carrier contracts
- Monitoring thresholds and runbooks approved by the NOC
- Escalation matrix and SLA: P1 acknowledged in 15 min, restored in 4 h
- 30-day hypercare after the last wave, then decommissioning of the MPLS CE routers

## Project KPIs
- First-time-right cutovers: target ≥ 92 %
- Availability per site: target 99.95 % (dual link)
- Average delay per wave: &lt; 2 working days</bpmn:documentation>
      <bpmn:incoming>Flow_training_1</bpmn:incoming>
      <bpmn:outgoing>Flow_run_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Service live">
      <bpmn:incoming>Flow_run_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_1" sourceRef="start" targetRef="kickoff" />
    <bpmn:sequenceFlow id="Flow_kickoff_1" sourceRef="kickoff" targetRef="inventory" />
    <bpmn:sequenceFlow id="Flow_inventory_1" sourceRef="inventory" targetRef="audit_merge" />
    <bpmn:sequenceFlow id="Flow_audit_merge_1" sourceRef="audit_merge" targetRef="audit" />
    <bpmn:sequenceFlow id="Flow_audit_1" sourceRef="audit" targetRef="ready" />
    <bpmn:sequenceFlow id="Flow_ready_1" name="Yes" sourceRef="ready" targetRef="design" />
    <bpmn:sequenceFlow id="Flow_ready_2" name="No" sourceRef="ready" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_fix_1" sourceRef="fix" targetRef="audit_merge" />
    <bpmn:sequenceFlow id="Flow_design_1" sourceRef="design" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_approve_1" sourceRef="approve" targetRef="configs" />
    <bpmn:sequenceFlow id="Flow_configs_1" sourceRef="configs" targetRef="install" />
    <bpmn:sequenceFlow id="Flow_install_1" sourceRef="install" targetRef="cutover_merge" />
    <bpmn:sequenceFlow id="Flow_cutover_merge_1" sourceRef="cutover_merge" targetRef="cutover" />
    <bpmn:sequenceFlow id="Flow_cutover_1" sourceRef="cutover" targetRef="checks" />
    <bpmn:sequenceFlow id="Flow_checks_1" sourceRef="checks" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_ok_1" name="Yes" sourceRef="ok" targetRef="acceptance" />
    <bpmn:sequenceFlow id="Flow_ok_2" name="No" sourceRef="ok" targetRef="rollback" />
    <bpmn:sequenceFlow id="Flow_rollback_1" sourceRef="rollback" targetRef="cutover_merge" />
    <bpmn:sequenceFlow id="Flow_acceptance_1" sourceRef="acceptance" targetRef="portal" />
    <bpmn:sequenceFlow id="Flow_portal_1" sourceRef="portal" targetRef="training" />
    <bpmn:sequenceFlow id="Flow_training_1" sourceRef="training" targetRef="run" />
    <bpmn:sequenceFlow id="Flow_run_1" sourceRef="run" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_1" bpmnElement="Collaboration_1">
