    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_pm" name="Project manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kickoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_eng" name="Network engineering">
        <bpmn:flowNodeRef>audit_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>portal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ai" name="Automation (AI agent)">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_noc" name="NOC">
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Contract received">
      <bpmn:outgoing>Flow_start_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="kickoff" name="Hold the kick-off" bpmnpilot:assignee="Claire Morel" bpmnpilot:systems="ITSM, project management tool" bpmnpilot:accountable="Head of operations" bpmnpilot:consulted="Customer" bpmnpilot:informed="NOC, network engineering">
      <bpmn:documentation>## Purpose
Align the scope, the wave plan and the governance with the customer.

## Deliverables
- Plan: site survey (W1 to W3), HLD (W4 to W6), 2-site pilot (W9), 5 waves of 7 to 8 sites (W10 to W16), 30-day hypercare
- Escalation matrix and on-site contacts
- Site inventory template sent to the customer
- Accepted maintenance window (MW) slots: Tuesday to Thursday, 10 pm to 2 am

## Watch out
DIA fibre lead time: 6 to 8 weeks. Order the circuits at kick-off.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Claire Morel" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_1</bpmn:incoming>
      <bpmn:outgoing>Flow_kickoff_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="inventory" name="Receive the inventory" bpmnpilot:systems="Spreadsheet, customer portal" bpmnpilot:accountable="Customer CIO" bpmnpilot:informed="Project manager">
      <bpmn:documentation>For each branch: site code, address, on-site contact, access hours.

| Data | Example |
|---|---|
| Current underlay | 20 Mb/s MPLS, carrier-managed CE router |
| New links | 300 Mb/s DIA fibre, 4G/5G backup |
| LAN | 3 VLANs: data, voice, guest |
| Prefixes | 10.40.12.0/24, 10.140.12.0/25 |
| Critical applications | ERP (SaaS), VoIP, point of sale |</bpmn:documentation>
      <bpmn:incoming>Flow_kickoff_1</bpmn:incoming>
      <bpmn:outgoing>Flow_inventory_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="audit_merge">
      <bpmn:incoming>Flow_inventory_1</bpmn:incoming>
      <bpmn:incoming>Flow_fix_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="audit" name="Run the site survey" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="CMDB, IPAM, survey app" bpmnpilot:accountable="Engineering lead" bpmnpilot:consulted="Customer" bpmnpilot:informed="Project manager" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="An agent reconciles the inventory, the survey records and the IPAM, and lists the gaps to check.">
      <bpmn:documentation>## Site survey checklist
- [ ] Access links delivered, tested for throughput (iPerf) and latency to the hubs
- [ ] 4G/5G coverage measured at the antenna location (RSRP &gt; -100 dBm)
- [ ] Rack space (1U), two UPS-backed power outlets
- [ ] Addressing plan with no overlap with other sites (IPAM)
- [ ] LAN ports and VLANs recorded on the access switch
- [ ] Photos of the rack and of the carrier demarc

Target: half a day per site. A finding blocks the site, not the wave.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Karim Benali" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_audit_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ready" name="Sites ready?">
      <bpmn:incoming>Flow_audit_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ready_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ready_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Get the findings cleared" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Network engineering" bpmnpilot:informed="Project manager">
      <bpmn:documentation>Typical findings: DIA circuit not delivered, power outlet not on UPS, address overlap with another site, 4G antenna to relocate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ready_2</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="design" name="Write the HLD and LLD" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="SD-WAN orchestrator, IPAM, wiki" bpmnpilot:accountable="Engineering lead" bpmnpilot:consulted="Security" bpmnpilot:informed="Customer" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="An agent fills the LLD sheets from the HLD and the IPAM. The engineer keeps the architecture decisions.">
      <bpmn:documentation>## HLD (High-Level Design)
- Hub and spoke topology: 2 data center hubs (active/active), 40 spokes
- Underlay: MPLS kept during the migration, DIA fibre, 4G/5G backup
- Overlay: IPsec tunnels from each spoke to both hubs, over every transport
- Routing: BGP in the overlay, eBGP to the PE on the MPLS link, BFD on every tunnel
- Application-aware policies: voice on MPLS (DIA fallback), SaaS through local breakout on DIA, guest on DIA only
- QoS: 4 classes (voice EF, interactive AF41, business AF21, best effort)
- Segmentation: 3 VRFs (corporate, voice, guest)

## LLD (Low-Level Design)
One sheet per site: interfaces, VLANs, prefixes, ASN, BGP neighbors, SLA probe thresholds, CPE serial number.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Karim Benali" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ready_1</bpmn:incoming>
      <bpmn:outgoing>Flow_design_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approve" name="Get the HLD signed off" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Customer CISO" bpmnpilot:informed="Project manager">
      <bpmn:documentation>The HLD is signed off before any CPE order. Any later change goes through a scope change request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_design_1</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="generate" name="Generate the ZTP templates" bpmnpilot:assignee="Configuration AI agent" bpmnpilot:systems="SD-WAN orchestrator, Git repository, IPAM, secrets vault" bpmnpilot:accountable="Engineering lead" bpmnpilot:informed="NOC" bpmnpilot:aiPotential="automate" bpmnpilot:aiPotentialReason="The agent fills the ZTP templates site by site and opens one merge request per wave." bpmnpilot:risks="Wrong configuration produced by the agent&#10;Secret (PSK, password) written in clear text" bpmnpilot:controls="Configuration linter and peer review&#10;Secrets read from the vault at deployment, never in the prompt" bpmnpilot:requirements="AI Act, art. 14 (human oversight); NIS2, art. 21">
      <bpmn:documentation>The agent fills the ZTP templates site by site from the LLD and the IPAM, runs the configuration linter and opens one merge request per wave. It pushes nothing to the devices.</bpmn:documentation>
      <bpmn:incoming>Flow_approve_1</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Peer-review the templates" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="Git repository" bpmnpilot:accountable="Engineering lead" bpmnpilot:informed="NOC" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Mandatory peer review before anything reaches the devices." bpmnpilot:risks="Merge request approved by its own author" bpmnpilot:controls="Segregation of duties: branch protection rule, the author cannot approve" bpmnpilot:requirements="ISO/IEC 27001, A.5.3">
      <bpmn:documentation>Peer review of every merge request: prefixes, ASN, BGP neighbors, application policies, no secret in clear text. The merge makes the configurations available in the orchestrator.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Karim Benali" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_generate_1</bpmn:incoming>
      <bpmn:outgoing>Flow_review_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="change" name="Manage the change">
      <bpmn:incoming>Flow_review_1</bpmn:incoming>
      <bpmn:outgoing>Flow_change_1</bpmn:outgoing>
      <bpmn:startEvent id="ch_start" name="RFC raised">
        <bpmn:outgoing>Flow_ch_start_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="ch_level" name="Classify the change" bpmnpilot:decisionRef="Decision_approvalLevel">
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="Decision_approvalLevel" resultVariable="level" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ch_start_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_level_1</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="ch_gw" name="Level?">
        <bpmn:incoming>Flow_ch_level_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_gw_1</bpmn:outgoing>
        <bpmn:outgoing>Flow_ch_gw_2</bpmn:outgoing>
        <bpmn:outgoing>Flow_ch_gw_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="ch_manager" name="Get change manager approval">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ch_gw_2</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_manager_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="ch_cab" name="Present at the CAB">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ch_gw_3</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_cab_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ch_merge">
        <bpmn:incoming>Flow_ch_gw_1</bpmn:incoming>
        <bpmn:incoming>Flow_ch_manager_1</bpmn:incoming>
        <bpmn:incoming>Flow_ch_cab_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_merge_1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="ch_window" name="Schedule the MW and notify the customer">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ch_merge_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_window_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ch_end" name="Change approved">
        <bpmn:incoming>Flow_ch_window_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ch_start_1" sourceRef="ch_start" targetRef="ch_level" />
      <bpmn:sequenceFlow id="Flow_ch_level_1" sourceRef="ch_level" targetRef="ch_gw" />
      <bpmn:sequenceFlow id="Flow_ch_gw_1" name="Standard" sourceRef="ch_gw" targetRef="ch_merge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=level = "Standard"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ch_gw_2" name="Normal" sourceRef="ch_gw" targetRef="ch_manager">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=level = "Normal"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ch_gw_3" name="CAB" sourceRef="ch_gw" targetRef="ch_cab">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=level = "CAB"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ch_manager_1" sourceRef="ch_manager" targetRef="ch_merge" />
      <bpmn:sequenceFlow id="Flow_ch_cab_1" sourceRef="ch_cab" targetRef="ch_merge" />
      <bpmn:sequenceFlow id="Flow_ch_merge_1" sourceRef="ch_merge" targetRef="ch_window" />
      <bpmn:sequenceFlow id="Flow_ch_window_1" sourceRef="ch_window" targetRef="ch_end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="cutover_merge">
      <bpmn:incoming>Flow_change_1</bpmn:incoming>
      <bpmn:incoming>Flow_rollback_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="cutover" name="Cut over the wave of sites" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, ITSM" bpmnpilot:accountable="NOC lead" bpmnpilot:consulted="Customer" bpmnpilot:informed="Project manager" bpmnpilot:risks="Outage outside the MW&#10;Loss of branch VoIP" bpmnpilot:controls="RFC approved before any action&#10;CE router backed up and kept for 7 days&#10;Rollback criteria written in the RFC" bpmnpilot:requirements="NIS2, art. 21; ITIL 4, change enablement">
      <bpmn:documentation>## Pre-checks (T-30 min)
- RFC approved, number posted on the bridge channel
- CPE online in the orchestrator, valid certificate, right software release
- Backup of the MPLS CE router configuration
- On-site contact reachable, test call to the VoIP system

## During the MW (10 pm to 2 am)
1. Move the LAN from the CE router to the SD-WAN CPE
2. Check that tunnels and BGP sessions come up
3. Advertise the site prefixes into the overlay
4. Keep the CE router in place for 7 days, cable ready for a fallback

Target: 45 min per site, 7 to 8 sites per wave. Go/no-go point at T+60 min.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Night NOC team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cutover_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="checks" name="Run the post-checks" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, monitoring" bpmnpilot:accountable="NOC lead" bpmnpilot:informed="Customer" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="An agent reads tunnel, BGP session and SLA probe status, and flags values outside the thresholds.">
      <bpmn:documentation>## Post-checks
1. IPsec tunnels up to both hubs, over DIA, MPLS and 4G
2. BGP sessions Established, received prefix count matching the LLD
3. BFD up, SLA probes within thresholds: latency &lt; 50 ms, jitter &lt; 10 ms, loss &lt; 1 % for the voice class
4. Application-aware routing: voice goes over MPLS, SaaS through local breakout
5. DSCP marking preserved end to end
6. Failover test: unplug the DIA, the ongoing call holds, convergence &lt; 1 s, then cut MPLS, 4G takes over
7. SNMP, syslog and NetFlow reaching the NOC monitoring

## Rollback criteria
- Critical application unreachable for more than 15 min
- Tunnels still down 30 min after the cutover
- Packet loss &gt; 2 % on the voice class</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Night NOC team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cutover_1</bpmn:incoming>
      <bpmn:outgoing>Flow_checks_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ok" name="Post-checks passed?">
      <bpmn:incoming>Flow_checks_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ok_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ok_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rollback" name="Execute the rollback" bpmnpilot:assignee="Night NOC team" bpmnpilot:systems="SD-WAN orchestrator, ITSM" bpmnpilot:accountable="NOC lead" bpmnpilot:informed="Customer, project manager" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Human go/no-go decision, taken within the MW.">
      <bpmn:documentation>1. Move the LAN back to the MPLS CE router, restore its configuration
2. Withdraw the site prefixes from the overlay
3. Check VoIP and the ERP from the site
4. Close the RFC as "rolled back", open a problem record, reschedule the site in the next wave

Target: 20 min, within the MW.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="Night NOC team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ok_2</bpmn:incoming>
      <bpmn:outgoing>Flow_rollback_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="acceptance" name="Organize the acceptance" bpmnpilot:systems="Customer portal" bpmnpilot:accountable="Customer CIO" bpmnpilot:consulted="Project manager" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Contractual commitment with the customer.">
      <bpmn:documentation>The customer runs the acceptance plan per wave (business applications, VoIP, guest access, link failover) and signs the acceptance report. A minor finding does not prevent sign-off.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ok_1</bpmn:incoming>
      <bpmn:outgoing>Flow_acceptance_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="portal" name="Open the customer portal (SSO)" bpmnpilot:systems="Customer portal, customer&#39;s directory (SAML)" bpmnpilot:accountable="Engineering lead" bpmnpilot:informed="Customer" bpmnpilot:risks="Portal access granted to the wrong people" bpmnpilot:controls="Accounts provisioned from the customer&#39;s directory (SAML), quarterly access review" bpmnpilot:requirements="GDPR, art. 32">
      <bpmn:documentation>SAML federation with the customer directory, two roles (read-only, network admin). The portal shows site availability, quality per link and SLA compliance.</bpmn:documentation>
      <bpmn:incoming>Flow_acceptance_1</bpmn:incoming>
      <bpmn:outgoing>Flow_portal_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="training" name="Train the customer&#39;s teams" bpmnpilot:assignee="Claire Morel" bpmnpilot:accountable="Head of operations" bpmnpilot:informed="Customer" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Being there with the customer&#39;s teams.">
      <bpmn:documentation>Two 2-hour sessions: reading the portal and the SLA reports, raising an incident and the escalation path.</bpmn:documentation>
      <bpmn:incoming>Flow_portal_1</bpmn:incoming>
      <bpmn:outgoing>Flow_training_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="run" name="Hand over to Run" bpmnpilot:assignee="NOC lead" bpmnpilot:systems="ITSM, monitoring, CMDB" bpmnpilot:accountable="Head of operations" bpmnpilot:informed="Customer, project manager">
      <bpmn:documentation>## Handover pack
- Up-to-date architecture document and LLD (as-built)
- CMDB populated: CPEs, circuits, carrier contracts
- Monitoring thresholds and runbooks approved by the NOC
- Escalation matrix and SLA: P1 acknowledged in 15 min, restored in 4 h
- 30-day hypercare after the last wave, then decommissioning of the MPLS CE routers

## Project KPIs
- First-time-right cutovers: target ≥ 92 %
- Availability per site: target 99.95 % (dual link)
- Average delay per wave: &lt; 2 working days</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="NOC lead" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_training_1</bpmn:incoming>
      <bpmn:outgoing>Flow_run_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Service live">
      <bpmn:incoming>Flow_run_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_1" sourceRef="start" targetRef="kickoff" />
    <bpmn:sequenceFlow id="Flow_kickoff_1" sourceRef="kickoff" targetRef="inventory" />
    <bpmn:sequenceFlow id="Flow_inventory_1" sourceRef="inventory" targetRef="audit_merge" />
    <bpmn:sequenceFlow id="Flow_audit_merge_1" sourceRef="audit_merge" targetRef="audit" />
    <bpmn:sequenceFlow id="Flow_audit_1" sourceRef="audit" targetRef="ready" />
    <bpmn:sequenceFlow id="Flow_ready_1" name="Yes" sourceRef="ready" targetRef="design" bpmnpilot:probability="80">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sitesReady = "Yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ready_2" name="No" sourceRef="ready" targetRef="fix" bpmnpilot:probability="20">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sitesReady = "No"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fix_1" sourceRef="fix" targetRef="audit_merge" />
    <bpmn:sequenceFlow id="Flow_design_1" sourceRef="design" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_approve_1" sourceRef="approve" targetRef="generate" />
    <bpmn:sequenceFlow id="Flow_generate_1" sourceRef="generate" targetRef="review" />
    <bpmn:sequenceFlow id="Flow_review_1" sourceRef="review" targetRef="change" />
    <bpmn:sequenceFlow id="Flow_change_1" sourceRef="change" targetRef="cutover_merge" />
    <bpmn:sequenceFlow id="Flow_cutover_merge_1" sourceRef="cutover_merge" targetRef="cutover" />
    <bpmn:sequenceFlow id="Flow_cutover_1" sourceRef="cutover" targetRef="checks" />
    <bpmn:sequenceFlow id="Flow_checks_1" sourceRef="checks" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_ok_1" name="Yes" sourceRef="ok" targetRef="acceptance" bpmnpilot:probability="92">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=postChecksPassed = "Yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ok_2" name="No" sourceRef="ok" targetRef="rollback" bpmnpilot:probability="8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=postChecksPassed = "No"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rollback_1" sourceRef="rollback" targetRef="cutover_merge" />
    <bpmn:sequenceFlow id="Flow_acceptance_1" sourceRef="acceptance" targetRef="portal" />
    <bpmn:sequenceFlow id="Flow_portal_1" sourceRef="portal" targetRef="training" />
    <bpmn:sequenceFlow id="Flow_training_1" sourceRef="training" targetRef="run" />
    <bpmn:sequenceFlow id="Flow_run_1" sourceRef="run" targetRef="end" />
  </bpmn:process>
