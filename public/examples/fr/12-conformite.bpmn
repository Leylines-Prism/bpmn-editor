<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmnpilot="https://bpmn.leylines.fr/schema/bpmn-pilot/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_client" name="Client (40 agences)" processRef="Process_client" />
    <bpmn:participant id="Participant_integrator" name="Néréide Networks" processRef="Process_onboarding" />
    <bpmn:messageFlow id="Message_1" name="Contrat" sourceRef="c_sign" targetRef="start" />
    <bpmn:messageFlow id="Message_2" name="Inventaire" sourceRef="c_inventory" targetRef="inventory" />
    <bpmn:messageFlow id="Message_3" name="HLD" sourceRef="approve" targetRef="c_design" />
    <bpmn:messageFlow id="Message_4" name="Cahier de recette" sourceRef="acceptance" targetRef="c_accept" />
  </bpmn:collaboration>
  <bpmn:process id="Process_client" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Besoin validé">
      <bpmn:outgoing>Flow_c_start_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_sign" name="Signer le contrat">
      <bpmn:incoming>Flow_c_start_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c_sign_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="c_inventory" name="Envoyer l&#39;inventaire des sites">
      <bpmn:incoming>Flow_c_sign_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c_inventory_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="c_design" name="Valider le HLD">
      <bpmn:incoming>Flow_c_inventory_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c_design_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c_accept" name="Prononcer la recette">
      <bpmn:incoming>Flow_c_design_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c_accept_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="c_end" name="Service accepté">
      <bpmn:incoming>Flow_c_accept_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c_start_1" sourceRef="c_start" targetRef="c_sign" />
    <bpmn:sequenceFlow id="Flow_c_sign_1" sourceRef="c_sign" targetRef="c_inventory" />
    <bpmn:sequenceFlow id="Flow_c_inventory_1" sourceRef="c_inventory" targetRef="c_design" />
    <bpmn:sequenceFlow id="Flow_c_design_1" sourceRef="c_design" targetRef="c_accept" />
    <bpmn:sequenceFlow id="Flow_c_accept_1" sourceRef="c_accept" targetRef="c_end" />
  </bpmn:process>
  <bpmn:process id="Process_onboarding" name="Mise en service SD-WAN managé" isExecutable="true" bpmnpilot:owner="Directeur des opérations" bpmnpilot:version="2.1" bpmnpilot:status="Validé" bpmnpilot:validatedOn="2026-11-20" bpmnpilot:scope="Mise en service SD-WAN managé, de la signature du contrat au transfert au Run, 40 agences en 5 vagues">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_pm" name="Chef de projet">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>kickoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_eng" name="Ingénierie réseau">
        <bpmn:flowNodeRef>audit_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>portal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ai" name="Automatisation (agent IA)">
        <bpmn:flowNodeRef>generate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_noc" name="NOC">
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Contrat reçu">
      <bpmn:outgoing>Flow_start_1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="kickoff" name="Tenir le kick-off" bpmnpilot:assignee="Claire Morel" bpmnpilot:systems="ITSM, outil de gestion de projet" bpmnpilot:accountable="Directeur des opérations" bpmnpilot:consulted="Client" bpmnpilot:informed="NOC, ingénierie réseau">
      <bpmn:documentation>## Objectif
Aligner le périmètre, le planning par vagues et la gouvernance avec le client.

## Livrables
- Planning : site survey (S1 à S3), HLD (S4 à S6), pilote 2 sites (S9), 5 vagues de 7 à 8 sites (S10 à S16), hypercare 30 jours
- Matrice d'escalade et contacts sur site
- Modèle d'inventaire des sites envoyé au client
- Créneaux de fenêtre de maintenance (MW) acceptés : du mardi au jeudi, 22 h à 2 h

## Points d'attention
Délai de livraison des liens fibre DIA : 6 à 8 semaines. Les commander dès le kick-off.</bpmn:documentation>
      <bpmn:incoming>Flow_start_1</bpmn:incoming>
      <bpmn:outgoing>Flow_kickoff_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="inventory" name="Recevoir l&#39;inventaire" bpmnpilot:systems="Tableur, portail client" bpmnpilot:accountable="DSI du client" bpmnpilot:informed="Chef de projet">
      <bpmn:documentation>Pour chaque agence : code site, adresse, contact sur site, horaires d'accès.

| Donnée | Exemple |
|---|---|
| Underlay actuel | MPLS 20 Mb/s, routeur CE opérateur |
| Nouveaux liens | Fibre DIA 300 Mb/s, 4G/5G en secours |
| LAN | 3 VLAN : data, voix, invités |
| Préfixes | 10.40.12.0/24, 10.140.12.0/25 |
| Applications critiques | ERP (SaaS), ToIP, caisse |</bpmn:documentation>
      <bpmn:incoming>Flow_kickoff_1</bpmn:incoming>
      <bpmn:outgoing>Flow_inventory_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="audit_merge">
      <bpmn:incoming>Flow_inventory_1</bpmn:incoming>
      <bpmn:incoming>Flow_fix_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="audit" name="Réaliser le site survey" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="CMDB, IPAM, application de survey" bpmnpilot:accountable="Responsable ingénierie" bpmnpilot:consulted="Client" bpmnpilot:informed="Chef de projet" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="Un agent rapproche l&#39;inventaire, les relevés du survey et l&#39;IPAM, et liste les écarts à vérifier.">
      <bpmn:documentation>## Checklist du site survey
- [ ] Liens d'accès livrés, testés en débit (iPerf) et en latence vers les hubs
- [ ] Couverture 4G/5G mesurée à l'emplacement de l'antenne (RSRP &gt; -100 dBm)
- [ ] Place en baie (1U), deux prises secourues (onduleur)
- [ ] Plan d'adressage sans chevauchement avec les autres sites (IPAM)
- [ ] Ports LAN et VLAN relevés sur le switch d'accès
- [ ] Photos de la baie et du point de livraison opérateur

Durée cible : une demi-journée par site. Toute réserve bloque le site, pas la vague.</bpmn:documentation>
      <bpmn:incoming>Flow_audit_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_audit_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ready" name="Sites prêts ?">
      <bpmn:incoming>Flow_audit_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ready_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ready_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Faire lever les réserves" bpmnpilot:accountable="DSI du client" bpmnpilot:consulted="Ingénierie réseau" bpmnpilot:informed="Chef de projet">
      <bpmn:documentation>Réserves typiques : lien DIA non livré, prise non secourue, chevauchement d'adressage avec un autre site, antenne 4G à déporter.</bpmn:documentation>
      <bpmn:incoming>Flow_ready_2</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="design" name="Rédiger le HLD et le LLD" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="Orchestrateur SD-WAN, IPAM, wiki" bpmnpilot:accountable="Responsable ingénierie" bpmnpilot:consulted="Sécurité" bpmnpilot:informed="Client" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="Un agent remplit les fiches LLD depuis le HLD et l&#39;IPAM. L&#39;ingénieur garde les choix d&#39;architecture.">
      <bpmn:documentation>## HLD (High-Level Design)
- Topologie hub and spoke : 2 hubs en datacenter (actif/actif), 40 spokes
- Underlay : MPLS conservé pendant la migration, fibre DIA, 4G/5G en secours
- Overlay : tunnels IPsec de chaque spoke vers les deux hubs, sur chaque transport
- Routage : BGP dans l'overlay, eBGP vers le PE sur le lien MPLS, BFD sur tous les tunnels
- Politiques applicatives : voix sur MPLS (repli DIA), SaaS en local breakout sur la DIA, invités en DIA seulement
- QoS : 4 classes (voix EF, interactif AF41, métier AF21, best effort)
- Segmentation : 3 VRF (corporate, voix, invités)

## LLD (Low-Level Design)
Une fiche par site : interfaces, VLAN, préfixes, ASN, voisins BGP, seuils des sondes SLA, numéro de série du CPE.</bpmn:documentation>
      <bpmn:incoming>Flow_ready_1</bpmn:incoming>
      <bpmn:outgoing>Flow_design_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approve" name="Faire valider le HLD" bpmnpilot:accountable="DSI du client" bpmnpilot:consulted="RSSI du client" bpmnpilot:informed="Chef de projet">
      <bpmn:documentation>Le HLD est signé avant toute commande de CPE. Toute modification ultérieure passe par une demande de changement de périmètre.</bpmn:documentation>
      <bpmn:incoming>Flow_design_1</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="generate" name="Générer les templates ZTP" bpmnpilot:assignee="Agent IA de configuration" bpmnpilot:systems="Orchestrateur SD-WAN, dépôt Git, IPAM, coffre de secrets" bpmnpilot:accountable="Responsable ingénierie" bpmnpilot:informed="NOC" bpmnpilot:aiPotential="automate" bpmnpilot:aiPotentialReason="L&#39;agent remplit les templates ZTP site par site et ouvre une merge request par vague." bpmnpilot:risks="Configuration erronée produite par l&#39;agent&#10;Secret (PSK, mot de passe) écrit en clair" bpmnpilot:controls="Linter de configuration et revue par un pair&#10;Secrets lus dans le coffre au déploiement, jamais dans le prompt" bpmnpilot:requirements="AI Act, art. 14 (contrôle humain) ; NIS2, art. 21">
      <bpmn:documentation>L'agent remplit les templates ZTP site par site à partir du LLD et de l'IPAM, lance le linter de configuration et ouvre une merge request par vague. Il ne pousse rien vers les équipements.</bpmn:documentation>
      <bpmn:incoming>Flow_approve_1</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Relire les templates (peer review)" bpmnpilot:assignee="Karim Benali" bpmnpilot:systems="Dépôt Git" bpmnpilot:accountable="Responsable ingénierie" bpmnpilot:informed="NOC" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Revue par un pair obligatoire avant tout envoi vers les équipements." bpmnpilot:risks="Merge request approuvée par son propre auteur" bpmnpilot:controls="Séparation des tâches : règle de protection de branche, l&#39;auteur ne peut pas approuver" bpmnpilot:requirements="ISO/IEC 27001, A.5.3">
      <bpmn:documentation>Revue par un pair de chaque merge request : préfixes, ASN, voisins BGP, politiques applicatives, absence de secret en clair. La fusion met les configurations à disposition dans l'orchestrateur.</bpmn:documentation>
      <bpmn:incoming>Flow_generate_1</bpmn:incoming>
      <bpmn:outgoing>Flow_review_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="change" name="Gérer le change">
      <bpmn:incoming>Flow_review_1</bpmn:incoming>
      <bpmn:outgoing>Flow_change_1</bpmn:outgoing>
      <bpmn:startEvent id="ch_start" name="RFC créée">
        <bpmn:outgoing>Flow_ch_start_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="ch_level" name="Classer le change">
        <bpmn:incoming>Flow_ch_start_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_level_1</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="ch_gw" name="Niveau ?">
        <bpmn:incoming>Flow_ch_level_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_gw_1</bpmn:outgoing>
        <bpmn:outgoing>Flow_ch_gw_2</bpmn:outgoing>
        <bpmn:outgoing>Flow_ch_gw_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="ch_manager" name="Faire approuver par le change manager">
        <bpmn:incoming>Flow_ch_gw_2</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_manager_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="ch_cab" name="Présenter au CAB">
        <bpmn:incoming>Flow_ch_gw_3</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_cab_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="ch_merge">
        <bpmn:incoming>Flow_ch_gw_1</bpmn:incoming>
        <bpmn:incoming>Flow_ch_manager_1</bpmn:incoming>
        <bpmn:incoming>Flow_ch_cab_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_merge_1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="ch_window" name="Planifier la MW et prévenir le client">
        <bpmn:incoming>Flow_ch_merge_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ch_window_1</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ch_end" name="Change approuvé">
        <bpmn:incoming>Flow_ch_window_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ch_start_1" sourceRef="ch_start" targetRef="ch_level" />
      <bpmn:sequenceFlow id="Flow_ch_level_1" sourceRef="ch_level" targetRef="ch_gw" />
      <bpmn:sequenceFlow id="Flow_ch_gw_1" name="Standard" sourceRef="ch_gw" targetRef="ch_merge" />
      <bpmn:sequenceFlow id="Flow_ch_gw_2" name="Normal" sourceRef="ch_gw" targetRef="ch_manager" />
      <bpmn:sequenceFlow id="Flow_ch_gw_3" name="CAB" sourceRef="ch_gw" targetRef="ch_cab" />
      <bpmn:sequenceFlow id="Flow_ch_manager_1" sourceRef="ch_manager" targetRef="ch_merge" />
      <bpmn:sequenceFlow id="Flow_ch_cab_1" sourceRef="ch_cab" targetRef="ch_merge" />
      <bpmn:sequenceFlow id="Flow_ch_merge_1" sourceRef="ch_merge" targetRef="ch_window" />
      <bpmn:sequenceFlow id="Flow_ch_window_1" sourceRef="ch_window" targetRef="ch_end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="cutover_merge">
      <bpmn:incoming>Flow_change_1</bpmn:incoming>
      <bpmn:incoming>Flow_rollback_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_merge_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="cutover" name="Basculer la vague de sites" bpmnpilot:assignee="Équipe NOC de nuit" bpmnpilot:systems="Orchestrateur SD-WAN, ITSM" bpmnpilot:accountable="Responsable NOC" bpmnpilot:consulted="Client" bpmnpilot:informed="Chef de projet" bpmnpilot:risks="Coupure de service hors de la MW&#10;Perte de la ToIP des agences" bpmnpilot:controls="RFC approuvée avant toute action&#10;Sauvegarde du routeur CE, conservé 7 jours&#10;Critères de rollback écrits dans la RFC" bpmnpilot:requirements="NIS2, art. 21 ; ITIL 4, gestion des changements">
      <bpmn:documentation>## Pre-checks (T-30 min)
- RFC approuvée, numéro reporté dans le canal de bridge
- CPE en ligne dans l'orchestrateur, certificat valide, bonne version logicielle
- Sauvegarde de la configuration du routeur CE MPLS
- Contact sur site joignable, appel test vers la ToIP

## Pendant la MW (22 h à 2 h)
1. Repasser le LAN du routeur CE sur le CPE SD-WAN
2. Vérifier la montée des tunnels et des sessions BGP
3. Annoncer les préfixes du site dans l'overlay
4. Garder le routeur CE en place 7 jours, câble prêt pour un retour

Durée cible : 45 min par site, 7 à 8 sites par vague. Point go/no-go à T+60 min.</bpmn:documentation>
      <bpmn:incoming>Flow_cutover_merge_1</bpmn:incoming>
      <bpmn:outgoing>Flow_cutover_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="checks" name="Exécuter les post-checks" bpmnpilot:assignee="Équipe NOC de nuit" bpmnpilot:systems="Orchestrateur SD-WAN, supervision" bpmnpilot:accountable="Responsable NOC" bpmnpilot:informed="Client" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="Un agent lit l&#39;état des tunnels, des sessions BGP et des sondes SLA, et signale les écarts aux seuils.">
      <bpmn:documentation>## Post-checks
1. Tunnels IPsec up vers les deux hubs, sur la DIA, le MPLS et la 4G
2. Sessions BGP Established, nombre de préfixes reçus conforme au LLD
3. BFD up, sondes SLA dans les seuils : latence &lt; 50 ms, gigue &lt; 10 ms, perte &lt; 1 % pour la classe voix
4. Pilotage applicatif : la voix passe par le MPLS, le SaaS sort en local breakout
5. Marquage DSCP conservé de bout en bout
6. Test de bascule : débrancher la DIA, l'appel en cours tient, convergence &lt; 1 s, puis couper le MPLS, la 4G prend le relais
7. Remontée SNMP, syslog et NetFlow dans la supervision du NOC

## Critères de rollback
- Application critique injoignable plus de 15 min
- Tunnels absents 30 min après le basculement
- Perte de paquets &gt; 2 % sur la classe voix</bpmn:documentation>
      <bpmn:incoming>Flow_cutover_1</bpmn:incoming>
      <bpmn:outgoing>Flow_checks_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ok" name="Post-checks OK ?">
      <bpmn:incoming>Flow_checks_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ok_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_ok_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rollback" name="Exécuter le rollback" bpmnpilot:assignee="Équipe NOC de nuit" bpmnpilot:systems="Orchestrateur SD-WAN, ITSM" bpmnpilot:accountable="Responsable NOC" bpmnpilot:informed="Client, chef de projet" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Décision go/no-go humaine, prise dans la MW.">
      <bpmn:documentation>1. Repasser le LAN sur le routeur CE MPLS, restaurer sa configuration
2. Retirer les préfixes du site de l'overlay
3. Vérifier la ToIP et l'ERP depuis le site
4. Clore la RFC en « rollback », ouvrir un problème, replanifier le site dans la vague suivante

Durée cible : 20 min, dans la MW.</bpmn:documentation>
      <bpmn:incoming>Flow_ok_2</bpmn:incoming>
      <bpmn:outgoing>Flow_rollback_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="acceptance" name="Organiser la recette" bpmnpilot:systems="Portail client" bpmnpilot:accountable="DSI du client" bpmnpilot:consulted="Chef de projet" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Engagement contractuel avec le client.">
      <bpmn:documentation>Le client déroule le cahier de recette par vague (applications métier, ToIP, accès invités, bascule de lien) et signe le PV de recette. Une réserve mineure n'empêche pas la signature.</bpmn:documentation>
      <bpmn:incoming>Flow_ok_1</bpmn:incoming>
      <bpmn:outgoing>Flow_acceptance_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="portal" name="Ouvrir le portail client (SSO)" bpmnpilot:systems="Portail client, annuaire du client (SAML)" bpmnpilot:accountable="Responsable ingénierie" bpmnpilot:informed="Client" bpmnpilot:risks="Accès au portail donné à de mauvaises personnes" bpmnpilot:controls="Comptes ouverts par l&#39;annuaire du client (SAML), revue trimestrielle des accès" bpmnpilot:requirements="RGPD, art. 32">
      <bpmn:documentation>Fédération SAML avec l'annuaire du client, deux rôles (lecture, administrateur réseau). Le portail montre la disponibilité des sites, la qualité par lien et le respect des SLA.</bpmn:documentation>
      <bpmn:incoming>Flow_acceptance_1</bpmn:incoming>
      <bpmn:outgoing>Flow_portal_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="training" name="Former les équipes du client" bpmnpilot:assignee="Claire Morel" bpmnpilot:accountable="Directeur des opérations" bpmnpilot:informed="Client" bpmnpilot:aiPotential="human" bpmnpilot:aiPotentialReason="Présence et échange avec les équipes du client.">
      <bpmn:documentation>Deux sessions de 2 h : lecture du portail et des rapports SLA, ouverture d'un incident et circuit d'escalade.</bpmn:documentation>
      <bpmn:incoming>Flow_portal_1</bpmn:incoming>
      <bpmn:outgoing>Flow_training_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="run" name="Transférer au Run" bpmnpilot:assignee="Responsable NOC" bpmnpilot:systems="ITSM, supervision, CMDB" bpmnpilot:accountable="Directeur des opérations" bpmnpilot:informed="Client, chef de projet">
      <bpmn:documentation>## Dossier de transfert au Run
- Dossier d'architecture technique (DAT) et LLD à jour (as-built)
- CMDB alimentée : CPE, liens, contrats opérateurs
- Seuils de supervision et runbooks validés par le NOC
- Matrice d'escalade et SLA : P1 pris en charge en 15 min, rétabli en 4 h
- Hypercare de 30 jours après la dernière vague, puis démontage des routeurs CE MPLS

## Indicateurs du projet
- Bascules réussies du premier coup : objectif ≥ 92 %
- Disponibilité par site : objectif 99,95 % (double lien)
- Retard moyen par vague : &lt; 2 jours ouvrés</bpmn:documentation>
      <bpmn:incoming>Flow_training_1</bpmn:incoming>
      <bpmn:outgoing>Flow_run_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Service en production">
      <bpmn:incoming>Flow_run_1</bpmn:incoming>
    </bpmn:endEvent>
