      <bpmndi:BPMNShape id="BPMNShape_fix" bpmnElement="fix" bioc:stroke="#C2410C" bioc:fill="#FFE3CC" color:background-color="#FFE3CC" color:border-color="#C2410C">
        <dc:Bounds x="1186" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
