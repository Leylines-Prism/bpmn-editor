        <dc:Bounds x="1186" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approve" bpmnElement="approve" bioc:stroke="#1E5FA8" bioc:fill="#E8F1FB" color:background-color="#E8F1FB" color:border-color="#1E5FA8">
        <dc:Bounds x="1386" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_configs" bpmnElement="configs" bioc:stroke="#1C7C54" bioc:fill="#E6F6F0" color:background-color="#E6F6F0" color:border-color="#1C7C54">
        <dc:Bounds x="1586" y="800" width="100" height="80" />
