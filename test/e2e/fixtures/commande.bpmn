      <bpmnpilot:analysis author="bpmn-pilot-e2e" date="2026-11-28T12:26:05.339Z" fingerprint="f80a66fe">
        <bpmnpilot:analysisText>Le processus est court. Un quart des commandes est refusé faute de stock.</bpmnpilot:analysisText>
        <bpmnpilot:analysisPoint kind="bottleneck" elements="Activity_1a98jbd">La vérification du stock attend l’ERP.</bpmnpilot:analysisPoint>
      </bpmnpilot:analysis>
