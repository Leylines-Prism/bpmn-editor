    <bpmn:sequenceFlow id="Flow_0obf52v" sourceRef="Activity_1a98jbd" targetRef="Gateway_1chs3vr" />
    <bpmn:task id="Activity_17wynp4" name="Expédier">
      <bpmn:incoming>Flow_03b108p</bpmn:incoming>
      <bpmn:outgoing>Flow_172snwb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_03b108p" name="Oui" sourceRef="Gateway_1chs3vr" targetRef="Activity_17wynp4" bpmnpilot:probability="75" bpmnpilot:probabilitySource="log">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stock &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0pl65yo" name="Commande expédiée">
      <bpmn:incoming>Flow_172snwb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_172snwb" sourceRef="Activity_17wynp4" targetRef="Event_0pl65yo" />
    <bpmn:task id="Activity_1um5gp9" name="Refuser la commande">
