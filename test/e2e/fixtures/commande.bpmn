    <bpmn:startEvent id="Start" name="Commande reçue">
      <bpmn:outgoing>Flow_0ucprvr</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_18y60wv" name="Recevoir la commande" bpmnpilot:assignee="Service client" bpmnpilot:systems="ERP, messagerie" bpmnpilot:accountable="Responsable ventes" bpmnpilot:consulted="Logistique" bpmnpilot:informed="Client" bpmnpilot:aiPotential="assist" bpmnpilot:aiPotentialReason="Extraction des champs, relecture humaine." bpmnpilot:risks="Commande mal saisie" bpmnpilot:controls="Double vérification" bpmnpilot:requirements="RGPD art. 30" bpmnpilot:userStories="En tant que client, je veux un accusé de réception, afin de savoir que ma commande est prise." bpmnpilot:acceptanceCriteria="Étant donné une commande, quand elle est saisie, alors un accusé part.">
      <bpmn:documentation>## Rôle
Saisir la commande **reçue**.</bpmn:documentation>
      <bpmn:incoming>Flow_0ucprvr</bpmn:incoming>
      <bpmn:outgoing>Flow_1hegy3t</bpmn:outgoing>
    </bpmn:userTask>
